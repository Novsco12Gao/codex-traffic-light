<Window x:Class="CodexTrafficLight.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="390"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">
    <!-- 设置窗口使用三行布局：标题、可滚动内容、底部操作按钮。 -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="设置"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1F2228"
                   Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 外观设置控制主窗口显示方式、主题和是否置顶。 -->
                <TextBlock Text="外观" FontWeight="Bold" Foreground="#3A3E46" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="显示方式" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <ComboBox x:Name="StyleComboBox" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="三灯" Tag="triple"/>
                        <ComboBoxItem Content="单灯" Tag="single"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="主题" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <ComboBox x:Name="ThemeComboBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="深色" Tag="dark"/>
                        <ComboBoxItem Content="浅色" Tag="light"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="窗口" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <CheckBox x:Name="TopmostCheckBox" Grid.Row="2" Grid.Column="1" Content="窗口置顶" VerticalAlignment="Center"/>
                </Grid>

                <!-- 灯效设置只影响动画表现，不改变红黄绿状态含义。 -->
                <TextBlock Text="灯效" FontWeight="Bold" Foreground="#3A3E46" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="模式" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <ComboBox x:Name="LampEffectComboBox" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="呼吸闪动" Tag="breath"/>
                        <ComboBoxItem Content="常亮" Tag="steady"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="速度" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <ComboBox x:Name="LampSpeedComboBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="慢" Tag="slow"/>
                        <ComboBoxItem Content="标准" Tag="standard"/>
                        <ComboBoxItem Content="快" Tag="fast"/>
                    </ComboBox>
                </Grid>

                <!-- 任务设置控制 hook 自动启动、开机启动、抽屉和提醒总开关。 -->
                <TextBlock Text="任务" FontWeight="Bold" Foreground="#3A3E46" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,14">
                    <CheckBox x:Name="AutoLaunchCheckBox" Content="Codex 活动时自动打开红绿灯" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="开机自动启动" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoOpenDrawerCheckBox" Content="黄灯时自动展开任务列表" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowEndedSessionsCheckBox" Content="显示已结束会话" Margin="0,0,0,8"/>
                    <CheckBox x:Name="MutedCheckBox" Content="静音"/>
                </StackPanel>

                <!-- 黄灯提醒模式决定等待权限时是否弹气泡、播放声音或只依赖灯效。 -->
                <TextBlock Text="提醒" FontWeight="Bold" Foreground="#3A3E46" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="黄灯提醒" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <ComboBox x:Name="ReminderModeComboBox" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="托盘气泡" Tag="balloon"/>
                        <ComboBoxItem Content="气泡和声音" Tag="balloon-sound"/>
                        <ComboBoxItem Content="只闪灯" Tag="flash"/>
                        <ComboBoxItem Content="关闭提醒" Tag="silent"/>
                    </ComboBox>
                </Grid>

                <!-- 会话保留设置使用正整数输入框，保存时由代码做无效输入兜底。 -->
                <TextBlock Text="会话保留" FontWeight="Bold" Foreground="#3A3E46" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="完成会话保留" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <TextBox x:Name="GreenRetentionTextBox" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center" Foreground="#5B606A" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="1" Text="黄灯会话保留" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <TextBox x:Name="YellowRetentionTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="分钟" VerticalAlignment="Center" Foreground="#5B606A" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="2" Text="红灯会话保留" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <TextBox x:Name="RedRetentionTextBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="分钟" VerticalAlignment="Center" Foreground="#5B606A" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="3" Text="CLI 运行中最长保留" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <TextBox x:Name="LiveCliRetentionTextBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="小时" VerticalAlignment="Center" Foreground="#5B606A" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="4" Text="VS Code 最长保留" VerticalAlignment="Center" Foreground="#5B606A"/>
                    <TextBox x:Name="LiveVsCodePluginRetentionTextBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="小时" VerticalAlignment="Center" Foreground="#5B606A" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 保存按钮返回 DialogResult，取消按钮直接关闭且不应用设置。 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="78" Height="30" Margin="0,0,8,0" Content="取消" IsCancel="True"/>
            <Button Width="78" Height="30" Content="保存" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
