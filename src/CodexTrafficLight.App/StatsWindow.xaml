<Window x:Class="CodexTrafficLight.App.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="统计"
        Width="420"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">
    <!-- 统计窗口只展示已经计算好的摘要，窗口内没有额外数据查询逻辑。 -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Codex 统计"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1F2228"
                   Margin="0,0,0,14"/>

        <!-- 中间区域左右两列分别展示今天和本周，字段顺序保持一致方便对比。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 今日统计卡片：由代码填充次数、完成数、总时长和平均时长。 -->
            <Border Background="White" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="今天" FontWeight="Bold" FontSize="15" Foreground="#1F2228" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TodayRedCountText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TodayGreenCountText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TodayDurationText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TodayAverageText" Foreground="#3A3E46"/>
                </StackPanel>
            </Border>

            <!-- 本周统计卡片：统计范围为周一到周日。 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="本周" FontWeight="Bold" FontSize="15" Foreground="#1F2228" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WeekRedCountText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WeekGreenCountText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WeekDurationText" Foreground="#3A3E46" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WeekAverageText" Foreground="#3A3E46"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 关闭按钮使用 IsCancel，用户按 Esc 也可以关闭窗口。 -->
        <Button Grid.Row="2"
                Width="78"
                Height="30"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Content="关闭"
                IsCancel="True"/>
    </Grid>
</Window>
